{
  "name": "patihaven-monorepo",
  "version": "1.0.0",
  "description": "Hayvan Barınağı Yönetim Platformu - PatiHaven",
  "main": "server/server.js",
  "scripts": {
    "install:all": "npm install && cd client && npm install",
    "server": "node server/server.js",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "generate-report": "node generate-report.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "type": "module"
}
